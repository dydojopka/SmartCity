Table issues {
  id varchar(36) [pk, note: 'UUID']
  user_id varchar(36) [not null, note: 'UUID from Identity Service; no cross-database FK']
  title varchar(200) [not null]
  description text [not null]
  category varchar(50) [not null]
  address varchar(300) [not null]
  status varchar(20) [not null, default: 'NEW', note: 'NEW, IN_PROGRESS, RESOLVED, REJECTED']
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    user_id
    category
    status
  }
}
