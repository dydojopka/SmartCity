digraph notification_schema {
  graph [rankdir=LR, bgcolor="transparent"];
  node [shape=plain fontname="Arial"];

  notifications [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id: INTEGER</TD></TR>
      <TR><TD ALIGN="LEFT">user_id: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">recipient: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">channel: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">subject: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">message: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">status: PENDING | SENT | FAILED</TD></TR>
      <TR><TD ALIGN="LEFT">created_at: DATETIME</TD></TR>
      <TR><TD ALIGN="LEFT">sent_at: DATETIME</TD></TR>
    </TABLE>
  >];
}