digraph identity_schema {
  graph [rankdir=LR, bgcolor="transparent"];
  node [shape=plain fontname="Arial"];

  users [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>users</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B> id: UUID</TD></TR>
      <TR><TD ALIGN="LEFT">email: TEXT UNIQUE</TD></TR>
      <TR><TD ALIGN="LEFT">password_hash: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">first_name: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">last_name: TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">role: USER | OPERATOR | ADMIN</TD></TR>
      <TR><TD ALIGN="LEFT">is_active: BOOLEAN</TD></TR>
      <TR><TD ALIGN="LEFT">created_at: DATETIME UTC</TD></TR>
    </TABLE>
  >];
}
